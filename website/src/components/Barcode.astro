---
// A deterministic barcode: bar widths from a fixed sequence, one unit of gap between bars.
interface Props {
  width?: number;
  height?: number;
  color?: string;
  class?: string;
}
const { width = 140, height = 32, color = 'currentColor', class: className } = Astro.props;
const widths = [2, 1, 1, 3, 1, 2, 1, 1, 1, 2, 3, 1, 1, 2, 1, 1, 2, 1, 3, 1, 1, 2, 1, 1, 1, 2, 1, 3, 1, 2];
const unit = 2;
let x = 0;
const bars = widths.map((w) => {
  const bar = { x, w: w * unit };
  x += (w + 1) * unit;
  return bar;
});
const total = x - unit;
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox={`0 0 ${total} 40`}
  preserveAspectRatio="none"
  fill={color}
  aria-hidden="true"
  focusable="false"
>
  {bars.map((b) => <rect x={b.x} y="0" width={b.w} height="40" />)}
</svg>
