---
import Mark from './Mark.astro';
import { links, nav } from '../data/content';
---

<header class="topbar">
  <div class="wrap topbar__grid">
    <a class="brand" href="#top" aria-label="AgentForge, back to top">
      <Mark size={30} class="brand__mark" />
      <span class="brand__name">AgentForge</span>
    </a>

    <div class="meta label" aria-label="Project status">
      <span class="meta__line">Compiler + runtime for AI inference silicon</span>
      <span class="meta__line">
        <i class="dot" aria-hidden="true"></i>
        Status: M0 baseline · 2026-10
        <span class="meta__sep" aria-hidden="true">/</span>
        Rust · Apache-2.0
      </span>
    </div>

    <nav class="nav" aria-label="Sections">
      {nav.map((item) => <a class="nav__link" href={item.href}>{item.label}</a>)}
    </nav>

    <a class="btn btn--hatch topbar__cta" href={links.repo} rel="noopener">
      Source <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .topbar__grid {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 32px;
    align-items: center;
    min-height: 76px;
    padding-block: 12px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--paper);
  }

  .brand:hover {
    color: var(--paper);
  }

  .brand__mark {
    color: var(--accent);
    flex: none;
  }

  .brand__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 19px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-variation-settings: 'wdth' 118;
    line-height: 1;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 32px;
    border-left: 1px solid var(--line);
  }

  .meta__line {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .meta__sep {
    color: var(--accent);
    padding-inline: 6px;
  }

  .nav {
    display: flex;
    gap: 26px;
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--paper-2);
    padding-block: 6px;
    border-bottom: 1px solid transparent;
  }

  .nav__link:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .topbar__cta {
    min-height: 44px;
  }

  @media (max-width: 1180px) {
    .meta {
      display: none;
    }

    .topbar__grid {
      grid-template-columns: auto 1fr auto;
    }

    .nav {
      justify-content: flex-end;
    }
  }

  @media (max-width: 820px) {
    .topbar__grid {
      grid-template-columns: 1fr auto;
      row-gap: 10px;
    }

    .nav {
      grid-column: 1 / -1;
      justify-content: flex-start;
      gap: 18px;
      overflow-x: auto;
      padding-bottom: 4px;
      scrollbar-width: none;
    }

    .nav::-webkit-scrollbar {
      display: none;
    }

    .topbar {
      position: static;
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .topbar__cta {
      grid-row: 1;
      grid-column: 2;
      padding-inline: 14px;
    }
  }
</style>
