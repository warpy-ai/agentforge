---
import Base from '../layouts/Base.astro';
import Topbar from '../components/Topbar.astro';
import Hero from '../components/Hero.astro';
import Ticker from '../components/Ticker.astro';
import Problem from '../components/Problem.astro';
import Thesis from '../components/Thesis.astro';
import Architecture from '../components/Architecture.astro';
import Results from '../components/Results.astro';
import Machines from '../components/Machines.astro';
import Quickstart from '../components/Quickstart.astro';
import Roadmap from '../components/Roadmap.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Topbar />
  <main id="main">
    <Hero />
    <Ticker />
    <Problem />
    <Thesis />
    <Architecture />
    <Results />
    <Machines />
    <Quickstart />
    <Roadmap />
  </main>
  <Footer />
